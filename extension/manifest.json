{
  "manifest_version": 3,
  "name": "Pastegate",
  "version": "0.1.0",
  "version_name": "0.1.0-alpha.3",
  "description": "Warns you before you paste passwords, API keys or personal data into a website.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "clipboardRead",
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "storage": {
    "managed_schema": "policy/managed_schema.json"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "locales/en.js",
        "locales/de.js",
        "locales/fr.js",
        "locales/es.js",
        "i18n.js",
        "editor-detect.js",
        "custom-rules.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "i18n.js",
        "locales/*.js",
        "config.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
