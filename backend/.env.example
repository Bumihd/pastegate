# Pastegate – environment variables
# Copy this file to .env and adjust all values.
# Never commit .env to Git.

DATABASE_URL=postgresql://pastegate:YOUR_DB_PASSWORD@localhost:5432/pastegate

# At least 64 random characters – generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# Separate salt for device hashes – also 64 random characters
HMAC_SALT=CHANGE_ME

DEBUG=false
EVENT_RETENTION_DAYS=90
# Devices that have not checked in for this long are deleted along with their events (0 = off)
DEVICE_RETENTION_DAYS=30

# Public server URL (embedded in the extension package)
SERVER_URL=https://pastegate.example.com

# Reverse proxies whose X-Forwarded-For uvicorn trusts (comma-separated, '*' = all).
# If another proxy/gateway sits in front of nginx, add its IP here – otherwise the
# login rate limit and audit log only see the gateway IP instead of the real client IP.
FORWARDED_ALLOW_IPS=127.0.0.1

# Azure SSO (OIDC) – leave empty if not used
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# LDAP / Active Directory – leave empty if not used
LDAP_HOST=
LDAP_PORT=636
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_ATTR=sAMAccountName
